<resources xmlns:tools="http://schemas.android.com/tools">
    <!--  Base application theme.  -->
    <style name="Base.Theme.Finanzify" parent="Theme.Material3.DayNight.NoActionBar">
        <!--  Customize your dark theme here.  -->
        <!--  <item name="colorPrimary">@color/my_dark_primary</item>  -->
        <item name="colorPrimary">@color/verde_oscuro</item>
        <!-- Desactivar el modo oscuro -->
    </style>

    <style name="Theme.Finanzify" parent="Base.Theme.Finanzify">
    <!--  Estilo de los botones  -->
    <item name="android:buttonStyle">@style/MyButtonStyle</item>
    </style>
    <style name="MyButtonStyle" parent="Widget.AppCompat.Button">
        <!--  Color de fondo del botón  -->
        <item name="android:background">@color/verde_oscuro</item>
        <!--  Color del texto del botón  -->
        <item name="android:textColor">@color/white</item>
    </style>
</resources>