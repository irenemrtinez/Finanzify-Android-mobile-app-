<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_ajustes"

    tools:context=".Ajustes.AjustesActivity"
    tools:ignore="ExtraText">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <ImageButton
            android:id="@+id/buttonVolver"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginLeft="10dp"
            android:background="@color/verde_oscuro"
            android:scaleType="fitCenter"
            android:src="@drawable/baseline_arrow_back_24"
            app:tint="@android:color/white"
            tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck"
            />

        <TextView
            android:id="@+id/textViewSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Ajustes"
            android:textColor="@color/white"
            android:textSize="20dp"
            android:textStyle="italic"
            tools:ignore="TextSizeCheck" />

    </RelativeLayout>
    
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        ></ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="20dp">


        <ImageView
            android:id="@+id/hueco"
            android:layout_width="50dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:src="@drawable/boton_rect_verde" />
        <ImageView
            android:id="@+id/pfp"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:src="@drawable/pfp_3" />

        <TextView
            android:id="@+id/textViewNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:textColor="@color/black"
            android:textSize="18dp"
            android:textStyle="italic"
            android:layout_below="@id/pfp"
            />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray" />
        <TextView
            android:id="@+id/textViewA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/textViewNombre"
            android:layout_gravity="left"
            android:layout_marginTop="11dp"
            android:layout_marginBottom="11dp"
            android:text="Ajustes de la cuenta"
            android:textColor="@color/gris"
            android:textSize="15dp"
            tools:ignore="TextSizeCheck" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textViewEditEP"
                android:layout_width="320dp"
                android:layout_height="26dp"
                android:layout_gravity="fill"
                android:layout_marginTop="17dp"
                android:text="Editar el Perfil "
                android:textColor="@color/black"
                android:textSize="17dp"
                tools:ignore="TextSizeCheck" />

            <ImageButton
                android:id="@+id/buttonEP"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="right"
                android:background="@color/white"
                android:src="@drawable/baseline_arrow_forward_ios_24"
                app:tint="@android:color/black"
                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textViewEditCC"
                android:layout_width="320dp"
                android:layout_height="26dp"
                android:layout_gravity="fill"
                android:layout_marginTop="17dp"
                android:text="Cambiar contraseña "
                android:textColor="@color/black"
                android:textSize="17dp"
                tools:ignore="TextSizeCheck" />

            <ImageButton
                android:id="@+id/buttonCC"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="right"
                android:background="@color/white"
                android:src="@drawable/baseline_arrow_forward_ios_24"
                app:tint="@android:color/black"
                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textViewEditCN"
                android:layout_width="320dp"
                android:layout_height="26dp"
                android:layout_gravity="fill"
                android:layout_marginTop="17dp"
                android:text="Configuración de notificaciones "
                android:textColor="@color/black"
                android:textSize="17dp"
                tools:ignore="TextSizeCheck" />

            <ImageButton
                android:id="@+id/buttonCN"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="right"
                android:background="@color/white"
                android:src="@drawable/baseline_arrow_forward_ios_24"
                app:tint="@android:color/black"
                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textViewEditV2FA"
                android:layout_width="310dp"
                android:layout_height="26dp"
                android:layout_gravity="fill"
                android:layout_marginTop="17dp"
                android:text="Verificación 2FA "
                android:textColor="@color/black"
                android:textSize="17dp"
                tools:ignore="TextSizeCheck" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch2FA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:switchMinWidth="50dp"
                ></androidx.appcompat.widget.SwitchCompat>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray"/>
        <TextView
            android:id="@+id/textViewAA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/textViewNombre"
            android:layout_gravity="left"
            android:layout_marginTop="11dp"
            android:layout_marginBottom="11dp"
            android:text="Ajustes adicionales"
            android:textColor="@color/gris"
            android:textSize="15dp"
            tools:ignore="TextSizeCheck" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textViewLim"
                android:layout_width="320dp"
                android:layout_height="26dp"
                android:layout_gravity="fill"
                android:layout_marginTop="17dp"
                android:text="Límites / Presupuestos"
                android:textColor="@color/black"
                android:textSize="17dp"
                tools:ignore="TextSizeCheck" />

            <ImageButton
                android:id="@+id/buttonLim"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="right"
                android:background="@color/white"
                android:src="@drawable/baseline_arrow_forward_ios_24"
                app:tint="@android:color/black"
                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textViewMoneda"
                android:layout_width="320dp"
                android:layout_height="26dp"
                android:layout_gravity="fill"
                android:layout_marginTop="17dp"
                android:text="Ajustes de Moneda"
                android:textColor="@color/black"
                android:textSize="17dp"
                tools:ignore="TextSizeCheck" />

            <ImageButton
                android:id="@+id/buttonmoneda"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="right"
                android:background="@color/white"
                android:src="@drawable/baseline_arrow_forward_ios_24"
                app:tint="@android:color/black"
                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textViewCategorias"
                android:layout_width="320dp"
                android:layout_height="26dp"
                android:layout_gravity="fill"
                android:layout_marginTop="17dp"
                android:text="Categorias "
                android:textColor="@color/black"
                android:textSize="17dp"
                tools:ignore="TextSizeCheck" />

            <ImageButton
                android:id="@+id/buttonCategorias"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="right"
                android:background="@color/white"
                android:src="@drawable/baseline_arrow_forward_ios_24"
                app:tint="@android:color/black"
                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

        </LinearLayout>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="30dp"

        >
    <Button
        android:id="@+id/buttonlogout"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/boton_rect_verde"
        android:text="Logout"
        android:layout_marginHorizontal="10dp"
        android:textSize="20dp" />
        <Button
            android:id="@+id/buttonexp"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/boton_rect_verde"
            android:text="Exportar"
            android:layout_marginHorizontal="10dp"
            android:textSize="20dp" />
    </LinearLayout>

</LinearLayout>