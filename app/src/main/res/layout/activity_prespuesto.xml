<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/buttonVolver"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="10dp"
                android:background="@color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/baseline_arrow_back_24"
                android:tint="@color/black"
                tools:ignore="UseAppTint,SpeakableTextPresentCheck,TouchTargetSizeCheck" />

            <TextView
                android:id="@+id/textViePr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="80dp"
                android:layout_marginBottom="30dp"
                android:text="Presupuestos"
                android:textColor="@color/verde_oscuro"
                android:textSize="25sp"
                android:textStyle="italic" />


        </LinearLayout>

    <!-- Segundo CardView para el RecyclerView -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_margin="8dp"
        android:elevation="4dp"
        android:background="#F0F0F0">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/transparent"
            android:scrollbars="vertical" />
    </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/buttonlimite"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="30dp"
            android:background="@drawable/rectangular_button_background"
            android:text="Crear Presupuesto"
            android:textSize="20dp" />


</LinearLayout>
