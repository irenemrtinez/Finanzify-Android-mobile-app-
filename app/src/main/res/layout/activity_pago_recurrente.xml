<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".TransaccionesRecurrentes.PagoRecurrenteActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/buttonVolver"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp"
            android:background="@color/transparent"
            android:scaleType="fitCenter"
            android:src="@drawable/baseline_arrow_back_24"
            app:tint="@color/verde_oscuro"
            tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

        <TextView
            android:id="@+id/textViewPagos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:text="PAGOS"
            android:textColor="@color/verde_oscuro"
            android:textSize="20sp"
            android:textStyle="bold|italic"
            android:gravity="center"
            tools:ignore="TextSizeCheck" />
        <TextView
            android:id="@+id/textViewIngresos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:text="INGRESOS"
            android:textColor="@color/verde_claro"
            android:textSize="20sp"
            android:textStyle="italic"
            android:gravity="center"
            tools:ignore="TextSizeCheck" />

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" >


        <TextView
            android:id="@+id/textViewcantidad"
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/textViewSettings"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="10dp"
            android:gravity="left"
            android:text="Cantidad"
            android:textColor="@color/verde_oscuro"
            android:textStyle="italic"
            android:textSize="20sp"
            tools:ignore="TextSizeCheck" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint=""
            app:boxBackgroundColor="@color/verde_oscuro"
            app:boxStrokeColor="@color/verde_oscuro"
            app:boxStrokeWidth="0dp"
            app:endIconMode="none">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/cantidadid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="0dp"
                android:layout_marginEnd="16dp"
                android:minHeight="48dp"
                android:textColor="@android:color/black"
                android:background="@color/verde_claro"
                android:backgroundTint="@color/verde_claro"
                android:textColorHint="@android:color/black"
                tools:ignore="SpeakableTextPresentCheck" />

        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            android:id="@+id/textViewcategoria"
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/textViewSettings"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="10dp"
            android:gravity="left"
            android:text="Categoria"
            android:textColor="@color/verde_oscuro"
            android:textStyle="italic"
            android:textSize="20sp"
            tools:ignore="TextSizeCheck" />

        <TextView
            android:id="@+id/buttoncategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="16dp"
            android:minHeight="48dp"
            android:layout_gravity="center"
            android:gravity="left|center"
            android:textColor="@android:color/black"
            android:background="@color/verde_claro"
            android:textSize="16sp"
            android:text=""
            android:paddingLeft="16dp"
            tools:ignore="SpeakableTextPresentCheck" />

        <TextView
            android:id="@+id/textViewmMensaje"
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/textViewSettings"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="10dp"
            android:gravity="left"
            android:text="Mensaje"
            android:textColor="@color/verde_oscuro"
            android:textStyle="italic"
            android:textSize="20sp"
            tools:ignore="TextSizeCheck" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint=""
            app:boxBackgroundColor="@color/verde_oscuro"
            app:boxStrokeColor="@color/verde_oscuro"
            app:boxStrokeWidth="0dp"
            app:endIconMode="none">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/Mensajeid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="0dp"
                android:layout_marginEnd="16dp"
                android:minHeight="48dp"
                android:textColor="@android:color/black"
                android:background="@color/verde_claro"
                android:backgroundTint="@color/verde_claro"
                android:textColorHint="@android:color/black"
                tools:ignore="SpeakableTextPresentCheck" />

        </com.google.android.material.textfield.TextInputLayout>

        <Spinner
            android:id="@+id/spinnerLapsos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="15dp"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/textViewfechaI"
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/textViewSettings"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="10dp"
            android:gravity="left"
            android:text="Fecha Inicio"
            android:textColor="@color/verde_oscuro"
            android:textStyle="italic"
            android:textSize="20sp"
            tools:ignore="TextSizeCheck" />

        <TextView
            android:id="@+id/buttonfechaI"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="16dp"
            android:minHeight="48dp"
            android:layout_gravity="center"
            android:gravity="left|center"
            android:textColor="@android:color/black"
            android:background="@color/verde_claro"
            android:textSize="16sp"
            android:text=""
            android:paddingLeft="16dp"
            tools:ignore="SpeakableTextPresentCheck" />
        <TextView
            android:id="@+id/textViewfechaF"
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/textViewSettings"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="10dp"
            android:gravity="left"
            android:text="Fecha Fin"
            android:textColor="@color/verde_oscuro"
            android:textStyle="italic"
            android:textSize="20sp"
            tools:ignore="TextSizeCheck" />

        <TextView
            android:id="@+id/buttonfechaF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="16dp"
            android:minHeight="48dp"
            android:layout_gravity="center"
            android:gravity="left|center"
            android:textColor="@android:color/black"
            android:background="@color/verde_claro"
            android:textSize="16sp"
            android:text=""
            android:paddingLeft="16dp"
            tools:ignore="SpeakableTextPresentCheck" />

        <Button
            android:id="@+id/buttonanadir"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="30dp"
            android:background="@drawable/rectangular_button_background"
            android:text="Añadir"
            android:textSize="20dp" />

    </LinearLayout>
</LinearLayout>